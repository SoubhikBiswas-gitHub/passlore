{
  "name": "passlore",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "build:play": "NEXT_PUBLIC_DEPLOYMENT_ENV=play NEXT_PUBLIC_SITE_URL=https://play.passlore.com opennextjs-cloudflare build",
    "deploy:play": "npm run build:play && opennextjs-cloudflare deploy --env play",
    "test": "playwright test --project=unit",
    "test:browser": "RUN_BROWSER_CHECKS=1 playwright test --project=chromium",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@phosphor-icons/react": "2.1.7",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.15.0",
    "motion": "^12.38.0",
    "next": "16.4.1",
    "next-themes": "0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "react-slider": "^2.0.6",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-slider": "^1.3.6",
    "patch-package": "^8.0.1",
    "postcss": "^8.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "wrangler": "^4.151.3"
  }
}
